FROM python:3.12-slim

WORKDIR /app

ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Download and setup Stockfish
RUN mkdir -p tools/stockfish && \
    wget -q https://github.com/official-stockfish/Stockfish/releases/download/sf17/stockfish-ubuntu-x86_64-avx2 -O tools/stockfish/stockfish && \
    chmod +x tools/stockfish/stockfish || echo "Failed to download stockfish"

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY engine engine
COPY assets assets

RUN make -C engine clean && make -C engine LDLIBS=

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "from backend.app.main import app; print(app.title)" || exit 1

CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]